# Rook hub configuration. Copy to .env (git-ignored) and fill in.
# docker compose reads .env automatically; for a bare-metal hub, export these
# in the environment of the hub service (e.g. a systemd EnvironmentFile).
# Every variable is optional unless marked REQUIRED.
#
# The hub is one process, `rook-hub` (`rook hub serve`): the dashboard and the
# MCP server together, reading every variable below. rook-dashboard and
# rook-mcp still run the two halves as separate processes (compat; each reads
# its own section).

# --- docker compose only ---------------------------------------------------
# Image and release to run (compose.yaml). Default: ghcr.io/bake-ware/rook:latest.
# ROOK_IMAGE=ghcr.io/bake-ware/rook
# ROOK_VERSION=0.2.0

# --- shared -----------------------------------------------------------------
# One directory for all hub state: setup.json, enrollment.db, API tokens,
# call journal, chat, vault, knowledge. Back it up; it holds band keys.
ROOK_DATA_DIR=./data

# Band pre-shared key. It only seeds the first band: after that, bands and key
# rotations live in the enrollment database (dashboard Bands page), which the
# dashboard and the MCP server share through ROOK_DATA_DIR, and a stale value
# here is ignored (the Settings page says so). Leave empty to use the
# dashboard's /setup wizard. Generate a strong one with:  python -m rook.remote.psk
ROOK_BAND_PSK=

# --- dashboard (rook-dashboard, python -m rook.remote.bootstrap) ------------
# REQUIRED unless the dashboard only listens on 127.0.0.1. Anyone who can log
# in can run commands on every worker.
ROOK_WEB_PASS=
ROOK_WEB_USER=admin
ROOK_BIND=0.0.0.0
ROOK_PORT=7005
# Public host[:port] of the dashboard, used in installer URLs. Add a scheme to
# be explicit (http://192.0.2.10:7005, https://rook.example.com); without one
# it is https unless it is a LAN/local address on ROOK_PORT (this dashboard's
# own plain HTTP) or port 80.
ROOK_DOMAIN=localhost:7005
# host:port that workers dial. For remote workers this is the hub's /band
# WebSocket bridge (wss on 443 behind a TLS proxy; with rook-hub it is on
# ROOK_PORT as well as ROOK_MCP_BIND); for LAN workers it can be the UDP relay
# directly (host:7474).
ROOK_HUB_PUBLIC=localhost:8765
# Optional: ws(s):// URL of the relay's native WebSocket listener (HUB_WS_BIND).
# Installers then start workers with --ws-url, skipping the MCP server's /band
# bridge. Unset keeps the bridge (docs/spec/core-v1.md 2.6).
# ROOK_HUB_PUBLIC_WS_URL=wss://relay.example.com/band
# UDP relay the dashboard joins.
ROOK_HUB_HOST=127.0.0.1
ROOK_HUB_PORT=7474

# --- MCP server (rook-mcp, python -m rook.band_mcp) -------------------------
# rook-hub serves /mcp (and /band, /authorize, /token, /.well-known/...) on
# ROOK_PORT above, using ROOK_HUB_HOST/PORT for the relay (ROOK_HUB only when
# those are unset).
ROOK_HUB=127.0.0.1:7474
# rook-mcp's listen address. rook-hub also serves the MCP server alone here,
# as rook-mcp did, for proxy routes and agents set up against it; "off" stops
# that (then point everything at ROOK_PORT).
ROOK_MCP_BIND=127.0.0.1:8765
# rook-hub: largest request body (bytes) the MCP paths accept; 413 above it.
# ROOK_MCP_MAX_BODY=16777216
# Optional fixed bearer token (simplest single-client setup). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ROOK_MCP_STATIC_TOKEN=
# When exposed publicly: the https URL and the Host headers to accept.
ROOK_MCP_PUBLIC_URL=
ROOK_ALLOWED_HOSTS=
# Opt-in shared knowledge wiki / task board (1 = on).
ROOK_KNOWLEDGE=0
# Plugin marketplace catalogs (preview; comma-separated https:// URLs). Empty
# shows a bundled example catalog on Manage > Plugins. Installing is not
# implemented yet (docs/design/plugin-marketplace.md).
# ROOK_PLUGIN_CATALOGS=
# rook_call reply shape: compact (default) or legacy (indented, hex "from",
# _journal_id, notices on every reply) for MCP clients that parse the old shape.
# ROOK_MCP_ENVELOPE=legacy

# --- worker (rook worker, python -m rook.worker) ----------------------------
# Usually passed as --hub/--psk by the installer; these are fallbacks.
# ROOK_HUB=hub.example.com:443
# ROOK_BAND_PSK=
# Signed OTA manifest URL (empty = no self-update).
# ROOK_UPDATE_URL=https://hub.example.com/band-worker.json
# After an update the new build must complete a band round trip within this
# many seconds or it rolls back to the previous bundle (0 = only check that it
# stays up for a minute). Enforced only if the old build had recent band
# contact and a peer to probe.
# ROOK_UPDATE_HEALTH_SECS=180
# Band transport tuning (also read by the hub's own band clients).
# Bulk (multi-fragment) frames on UDP are paced so a large reply doesn't
# overflow the relay's shared egress queue: frames per second (0 = no pacing)
# and the burst allowed before pacing starts. WS links are never paced.
# ROOK_BAND_UDP_PACE_RATE=2000
# ROOK_BAND_UDP_PACE_BURST=64
# Inbound requests handled at once, and how many more may wait; beyond that
# new requests are shed with a (rate-limited) warning, and a worker answers a
# shed request aimed at it "busy". Replies, announces and Drop packets are
# never shed (the receive loop slows down instead).
# ROOK_BAND_DISPATCH_CONCURRENCY=64
# ROOK_BAND_DISPATCH_BACKLOG=1024
# Negotiated extensions (docs/spec/core-v1.md section 14). Addressed routing:
# declare a route id and address replies/targeted calls (0 = off, all
# broadcast). Replies over this many bytes ride Drop when the caller accepts
# it (0 = never); no reply may exceed the cap. Native DROP frames for OTA
# toward workers that take them (0 = keep the pass-through form).
# ROOK_BAND_ROUTE=1
# ROOK_BAND_DROP_THRESHOLD=32768
# ROOK_BAND_MAX_REPLY_BYTES=33554432
# ROOK_BAND_DROP_NATIVE=1
# Hash-only announces (caps sent on change and every 10th announce). KEEP OFF
# (the default) until every hub and the Android APK on the band understand
# caps_hash: hubs up to build 426 and APK 0.4.1 read an announce without caps
# as "no caps", so their worker lists and rook_caps go empty between full
# announces. See docs/spec/core-v1.md 14.5.
# ROOK_ANNOUNCE_CAPS_HASH=0
# Worker: full ws(s):// URL of the band endpoint (implies --ws).
# ROOK_HUB_WS_URL=
# Trusted OTA signing public key (python rook/remote/update_keys.py pubkey).
# Bundles from a hub already carry the hub's key; unset in a source checkout
# means no update or deauth order is trusted.
# ROOK_UPDATE_PUBKEY=
# Worker state directory (identity, enrollment, pushed config, audit log,
# plugin data). Default ~/.rook-band-worker; set it to run a second worker on
# one machine. The installed bundle and venv stay in ~/.rook-band-worker.
# Older releases kept everything but the session mirror in ~/.rook-band-worker,
# so at its first start a worker with ROOK_WORKER_HOME set copies state missing
# there (worker_id, enrollment, deauth flag, pushed config, ...) from it, once.
# For a second worker with its own identity set ROOK_WORKER_HOME_FRESH=1 too.
# A deauth flag in ~/.rook-band-worker is honoured either way.
# ROOK_WORKER_HOME=
# ROOK_WORKER_HOME_FRESH=
# Claude Code rules (Manage > Claude Code): extra Claude Code config folders
# to add Rook's managed hooks to, besides CLAUDE_CONFIG_DIR or ~/.claude
# (os.pathsep-separated). The hook reads ROOK_AGENT from a session's
# environment for agent-scoped rules.
# ROOK_CCMOD_CLAUDE_DIRS=

# --- terminal dashboard (rook / rook band) ----------------------------------
# ROOK_WEB_URL=http://127.0.0.1:7005

# --- plugin host (hub and workers) -------------------------------------------
# Seconds a capability call may run before core abandons it with a timeout
# error (default 300; 0 = no limit). Caps that take a timeout argument
# (shell.exec) get that plus a margin; long-running caps opt out.
# ROOK_CAP_TIMEOUT=300
