# PiKVM rook worker environment.
# Copy to /etc/rook-worker.env and tighten perms: chmod 600 /etc/rook-worker.env
# Reload after edits: systemctl daemon-reload && systemctl restart rook-worker

# --- band ---
ROOK_HUB=hub.bakeforge.com:7474
ROOK_BAND_PSK=<set-me>
ROOK_WORKER_NAME=pikvm-rack1

# --- PiKVM API auth (used by pikvm.* caps) ---
PIKVM_URL=https://localhost
PIKVM_USER=admin
PIKVM_PASS=<set-me>
PIKVM_INSECURE=1
