      ]
     }
    ],
    [
     "session",
     {
      "grants": [
       "*"
      ]
     }
    ]
   ],
   "call": {
    "cap": "knowledge.page.get",
    "risk": "read",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "name": "on behalf of: agent can't exceed its own grants",
   "layers": [
    [
     "person",
     {
      "grants": [
       "*"
      ]
     }
    ],
    [
     "agent",
     {
      "grants": [
       "knowledge.*"
      ]
     }
    ],
    [
     "session",
     {
      "grants": [
       "*"
      ]
     }
    ]
   ],
   "call": {
    "cap": "shell.exec",
    "risk": "exec",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": false,
    "layer": "agent",
    "reason": "grants"
   }
  },
  {
   "name": "on behalf of: agent can't exceed the person",
   "layers": [
    [
     "person",
     {
      "grants": [
       "*"
      ],
      "max_risk": "write"
     }
    ],
    [
     "agent",
     {
      "grants": [
       "*"
      ]
     }
    ],
    [
     "session",
     {
      "grants": [
       "*"
      ]
     }
    ]
   ],
   "call": {
    "cap": "shell.exec",
    "risk": "exec",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": false,
    "layer": "person",
    "reason": "risk"
   }
  },
  {
   "name": "session scope narrows",
   "layers": [
    [
     "person",
     {
      "grants": [
       "*"
      ]
     }
    ],
    [
     "agent",
     {
      "grants": [
       "*"
      ]
     }
    ],
    [
     "session",
     {
      "grants": [
       "deluge.*",
       "info.*"
      ]
     }
    ]
   ],
   "call": {
    "cap": "shell.exec",
    "risk": "exec",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": false,
    "layer": "session",
    "reason": "grants"
   }
  },
  {
   "name": "plugin uses narrows",
   "layers": [
    [
     "person",
     {
      "grants": [
       "*"
      ]
     }
    ],
    [
     "session",
     {
      "grants": [
       "*"
      ]
     }
    ],
    [
     "uses",
     {
      "grants": [
       "notify.send"
      ]
     }
    ]
   ],
   "call": {
    "cap": "shell.exec",
    "risk": "exec",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": false,
    "layer": "uses",
    "reason": "grants"
   }
  },
  {
   "name": "first refusing layer is reported",
   "layers": [
    [
     "person",
     {
      "grants": [
       "*"
      ],
      "max_risk": "read"
     }
    ],
    [
     "agent",
     {
      "grants": [
       "info.*"
      ]
     }
    ]
   ],
   "call": {
    "cap": "shell.exec",
    "risk": "exec",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": false,
    "layer": "person",
    "reason": "risk"
   }
  },
  {
   "name": "no layers refuse nothing",
   "layers": [],
   "call": {
    "cap": "shell.exec",
    "risk": "exec",
    "effects": [],
    "target": "kaiju"
   },
   "expect": {
    "ok": true
   }
  }
 ]
}
