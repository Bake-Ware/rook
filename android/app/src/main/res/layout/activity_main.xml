<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_hub"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/psk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_psk"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="textNoSuggestions" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop" />

        <Button
            android:id="@+id/btnGrantScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_screen" />

        <Button
            android:id="@+id/btnGrantA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_a11y" />

        <Button
            android:id="@+id/btnGrantBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_battery" />

        <Button
            android:id="@+id/btnGrantNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_notif" />

        <Button
            android:id="@+id/btnGrantPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_perms" />

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_overlay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/voice_section"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/voiceUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_voice_url"
            android:inputType="textUri" />

        <CheckBox
            android:id="@+id/voiceInsecure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/voice_insecure" />

        <CheckBox
            android:id="@+id/wakeEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/wake_enabled" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnVoiceStandby"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/voice_standby" />
            <Button
                android:id="@+id/btnVoiceOff"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/voice_off" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVoiceStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_start" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnVoiceInterrupt"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/voice_interrupt" />
            <Button
                android:id="@+id/btnVoiceEnd"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/voice_end" />
        </LinearLayout>

        <TextView
            android:id="@+id/voiceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="idle"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/voiceLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
