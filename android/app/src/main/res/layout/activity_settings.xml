<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_band"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_hub"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/psk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_psk"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="textNoSuggestions" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_grants"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGrantScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_screen" />

        <Button
            android:id="@+id/btnGrantA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_a11y" />

        <Button
            android:id="@+id/btnGrantBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_battery" />

        <Button
            android:id="@+id/btnGrantNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_notif" />

        <Button
            android:id="@+id/btnGrantPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_perms" />

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_overlay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/voice_section"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/voiceUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_voice_url"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/voiceToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_voice_token"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/voiceInsecure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/voice_insecure" />

        <CheckBox
            android:id="@+id/wakeEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/wake_enabled" />

        <Button
            android:id="@+id/btnSaveVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_voice" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
