<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of widget_waiting, with example rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_waiting_header"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_waiting_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_waiting_name"
                android:textColor="@color/rook_fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_waiting_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/rook_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="2" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_waiting_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_talk_name"
            android:padding="8dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_preview_row1"
            android:textColor="@color/rook_accent"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_preview_row2"
            android:textColor="@color/rook_fg"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
