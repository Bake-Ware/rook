<resources>
<style name="Theme.Rook" parent="Theme.Material3.Dark.NoActionBar">
<item name="colorPrimary">@color/rook_accent</item><item name="colorOnPrimary">@color/rook_bg</item>
<item name="colorSecondary">#A4BC92</item><item name="colorSurface">@color/rook_panel</item>
<item name="colorOnSurface">@color/rook_fg</item><item name="android:colorBackground">@color/rook_bg</item>
<item name="android:windowBackground">@color/rook_bg</item><item name="android:statusBarColor">@color/rook_bg</item>
<item name="android:navigationBarColor">@color/rook_bg</item><item name="android:windowLightStatusBar">false</item>
<item name="android:textColorPrimary">@color/rook_fg</item><item name="android:textColorSecondary">@color/rook_dim</item>
<item name="materialButtonStyle">@style/RookButton</item><item name="materialButtonOutlinedStyle">@style/RookOutlinedButton</item>
<item name="editTextStyle">@style/RookInput</item>
</style>
<style name="RookButton" parent="Widget.Material3.Button"><item name="cornerRadius">2dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item></style>
<style name="RookOutlinedButton" parent="Widget.Material3.Button.OutlinedButton"><item name="cornerRadius">2dp</item><item name="strokeColor">@color/rook_line</item><item name="android:minHeight">52dp</item></style>
<style name="RookInput" parent="Widget.AppCompat.EditText"><item name="android:background">@drawable/rook_panel</item><item name="android:padding">12dp</item><item name="android:minHeight">52dp</item><item name="android:textSize">15sp</item><item name="android:textColorHint">@color/rook_dim</item></style>
<style name="RookPanel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:padding">16dp</item><item name="android:layout_marginTop">12dp</item><item name="android:background">@drawable/rook_panel</item></style>
<style name="RookSectionLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">12sp</item><item name="android:textColor">@color/rook_accent</item><item name="android:fontFamily">monospace</item><item name="android:letterSpacing">0.08</item><item name="android:paddingBottom">8dp</item></style>
<style name="RookFieldLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">12sp</item><item name="android:textColor">@color/rook_dim</item><item name="android:paddingTop">10dp</item><item name="android:paddingBottom">6dp</item></style>
<style name="RookHelp"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">12sp</item><item name="android:textColor">@color/rook_dim</item><item name="android:paddingTop">4dp</item></style>
</resources>