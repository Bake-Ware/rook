{
  "version": 1,
  "about": "Default notification rules. First match wins; see AttentionRules.kt and docs/design/attention-phone.md. The hub can replace or extend these with attention.rules_set.",
  "family_names": [],
  "family_starred": true,
  "default": "normal",
  "rules": [
    {"priority": "ignore", "category": "system", "note": "default: clocks and system noise",
     "match": {"packages": ["com.android.systemui", "deskclock", "clockpackage", "com.google.android.gms", "com.android.vending",
                            "com.android.providers.downloads", "com.samsung.android.lool", "com.android.settings"]}},
    {"priority": "ignore", "category": "shopping", "note": "default: shops and shipping apps",
     "match": {"packages": ["com.amazon.mshop", "com.amazon.windowshop", "com.ups.", "com.fedex", "com.usps", "com.ebay", "com.einnovation.temu",
                            "com.zzkko", "com.walmart", "com.target", "com.contextlogic.wish", "com.alibaba", "com.shopify"],
               "app_labels": ["amazon shopping", "ups", "fedex", "usps", "informed delivery", "temu", "shein", "walmart", "target", "ebay"]}},
    {"priority": "ignore", "category": "social", "note": "default: social feeds and news",
     "match": {"packages": ["com.facebook.katana", "com.instagram.android", "com.twitter.android", "com.zhiliaoapp.musically", "com.reddit.frontpage",
                            "com.linkedin.android", "com.pinterest", "com.google.android.youtube", "com.google.android.apps.magazines",
                            "com.cnn.mobile", "com.nytimes", "com.foxnews", "bbc.mobile.news", "flipboard", "com.particlenews",
                            "com.microsoft.amp.apps.bingnews", "com.yahoo.mobile.client.android.yahoo"],
               "app_labels": ["news"]}},
    {"priority": "urgent", "category": "urgent", "note": "default: alarm words, only from people, school, health or home-safety apps",
     "match": {"words": ["fire", "emergency", "evacuat", "lockdown", "911", "urgent", "ambulance", "injured", "hurt", "police", "alarm",
                         "pick up now", "call me"]},
     "scope": {"packages": ["messaging", "mms", "sms", "com.whatsapp", "org.thoughtcrime.securesms", "org.telegram", "com.facebook.orca",
                            "com.google.android.apps.dynamite", "com.discord", "com.microsoft.teams", "dialer", "com.android.phone",
                            "classdojo", "com.remind101", "parentsquare", "schoology", "seesaw", "bloomz", "skyward", "powerschool",
                            "mychart", "life360", "com.ringapp", "com.nest", "com.google.android.apps.chromecast.app", "simplisafe",
                            "com.adt.", "cellbroadcast"],
               "app_labels": ["school", "messages", "health", "hospital", "pharmacy"],
               "senders": ["@family"]},
     "except": {"words": ["% off", "sale", "coupon", "promo", "deals", "unsubscribe"]}},
    {"priority": "family", "category": "family", "note": "default: family names and starred contacts",
     "match": {"senders": ["@family"]}},
    {"priority": "family", "category": "school", "note": "default: school apps",
     "match": {"packages": ["classdojo", "com.remind101", "parentsquare", "schoology", "seesaw", "bloomz", "skyward", "powerschool", "instructure"],
               "app_labels": ["school"], "words": ["school"]},
     "except": {"words": ["% off", "coupon", "promo", "unsubscribe", "school board", "work or school", "school or work", "school account"]}},
    {"priority": "family", "category": "health", "note": "default: health, pharmacy and doctors",
     "match": {"packages": ["mychart", "com.cvs", "walgreen", "com.goodrx", "teladoc", "zocdoc"],
               "app_labels": ["health", "pharmacy", "hospital", "doctor", "mychart", "clinic"],
               "words": ["pharmacy", "hospital", "doctor", "prescription", "mychart"]},
     "except": {"words": ["% off", "sale", "coupon", "promo", "deal", "unsubscribe", "rewards"]}},
    {"priority": "ignore", "category": "shipping", "note": "default: deliveries",
     "match": {"words": ["out for delivery", "delivered", "your package", "your order", "tracking number", "shipped"]}},
    {"priority": "ignore", "category": "promo", "note": "default: marketing",
     "match": {"words": ["% off", "sale", "deal", "coupon", "promo", "limited time", "free shipping", "rewards", "cashback"]}},
    {"priority": "ignore", "category": "newsletter", "note": "default: newsletters",
     "match": {"words": ["newsletter", "unsubscribe", "weekly digest", "daily digest", "roundup"]}}
  ]
}
