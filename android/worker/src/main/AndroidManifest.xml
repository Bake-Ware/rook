<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The worker: its link to the hub, kept up in a foreground service, and started again after boot. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- location.get with the app closed: the service also of type location, once location all the time is given. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The worker's notification, and asking for a permission while the app is in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- phone.vibrate. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- app.launch, app.open_url, app.share, app.settings and clipboard.get: opening a screen from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- sound.dnd, and sound.set's silent ringer: Do Not Disturb access. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- sms.list, sms.send. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- call.list, call.dial. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- contact.search. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- calendar.list; calendar.create, calendar.update, calendar.delete. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- location.get, with the app closed: fine and coarse together, then all the time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- clock.timer, clock.alarm, clock.alarms: the clock app's intents. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- screen.capture without the accessibility service: Android's screen capture, in a service of its own type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- app.list and app.launch: the launcher's apps; app.open_url and app.share: which app takes a link or a share. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- call.dial, the clock caps and location.show: which app takes them. -->
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <!-- directBootAware (brief AP8): the parts that run before the phone is unlocked for the first time after
         it restarts, so the worker links and phone.unlock can unlock it. What they keep is in Storage.kt. -->
    <application>
        <service
            android:name=".WorkerService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This phone is a worker on its owner's Rook hub: a link that stays open so the owner's agents can use the phone." />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- notification-android and media-android (brief AP4): the one notification listener, bound by Android once
             the person gives Rook notification access; the buttons on the phone's own cards, and a tap on one. -->
        <service
            android:name=".NotificationListener"
            android:directBootAware="true"
            android:exported="true"
            android:label="Rook"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".CardReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <activity
            android:name=".CardOpened"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The hands and eyes (brief AP5): hid.*, ui.*, screen.capture's screenshot, phone.unlock. -->
        <service
            android:name=".Hands"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/rook_hands_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/rook_hands" />
        </service>

        <!-- screen.capture's MediaProjection session. -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- screen.on, phone.unlock: the screen on, over the lock screen. -->
        <activity
            android:name=".WakeActivity"
            android:directBootAware="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
