{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rook",
  "version": "0.1.0",
  "identifier": "systems.bake.rook.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Rook on your desktop",
    "longDescription": "A tray app for a Rook hub: the dashboard in a window, a global hotkey to ask the home agent, notifications, push-to-talk and an optional wake word.",
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../scripts/install-hub.sh": "install-hub.sh",
      "../../android/app/src/main/assets/wakeword/melspectrogram.onnx": "wakeword/melspectrogram.onnx",
      "../../android/app/src/main/assets/wakeword/embedding_model.onnx": "wakeword/embedding_model.onnx"
    }
  }
}
