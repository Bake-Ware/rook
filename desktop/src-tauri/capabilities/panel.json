{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The Rook panel: what waits on you, work, knowledge and sessions (read-only lists; items open in the dashboard window).",
  "windows": ["panel"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-panel-data",
    "allow-open-dashboard-cmd",
    "allow-ask-on-page-cmd",
    "allow-show-window",
    "allow-open-settings"
  ]
}
